{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "ob:core_mini",
      "is_spawnable": true,
      "is_summonable": true
    },
    "component_groups": {
      "ob:despawn": {
        "minecraft:instant_despawn": {}
      }
    },
    "components": {
      "minecraft:type_family": { "family": ["ob_mini", "monster", "mob"] },
      "minecraft:scale": { "value": 0.28 },
      "minecraft:collision_box": { "width": 0.5, "height": 1.1 },
      "minecraft:health": { "value": 24, "max": 24 },
      "minecraft:movement": { "value": 0.45 },
      "minecraft:navigation.walk": { "can_walk": true, "avoid_water": true },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:physics": {},
      "minecraft:fire_immune": {},
      "minecraft:attack": { "damage": 5 },
      "minecraft:follow_range": { "value": 32, "max": 32 },
      "minecraft:experience_reward": { "on_death": "5" },
      "minecraft:timer": {
        "time": 45,
        "looping": false,
        "time_down_event": { "event": "ob:expire" }
      },
      "minecraft:damage_sensor": {
        "triggers": [
          { "cause": "fall", "deals_damage": false },
          { "cause": "fire", "deals_damage": false },
          { "cause": "fire_tick", "deals_damage": false },
          { "cause": "lava", "deals_damage": false },
          { "cause": "magma", "deals_damage": false }
        ]
      },
      "minecraft:behavior.hurt_by_target": { "priority": 1 },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 2,
        "must_see": false,
        "reselect_targets": true,
        "within_radius": 32,
        "entity_types": [
          {
            "filters": { "test": "is_family", "subject": "other", "value": "player" },
            "max_dist": 32
          }
        ]
      },
      "minecraft:behavior.melee_box_attack": {
        "priority": 3,
        "cooldown_time": 0.7,
        "speed_multiplier": 1.35,
        "horizontal_reach": 0.5
      },
      "minecraft:behavior.random_stroll": { "priority": 6, "speed_multiplier": 0.8 },
      "minecraft:behavior.look_at_player": { "priority": 7, "look_distance": 10 },
      "minecraft:behavior.random_look_around": { "priority": 8 }
    },
    "events": {
      "ob:expire": {
        "add": { "component_groups": ["ob:despawn"] }
      }
    }
  }
}
