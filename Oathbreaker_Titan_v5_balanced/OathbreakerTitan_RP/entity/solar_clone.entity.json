{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "ob:solar_clone",
      "materials": { "default": "entity_alphatest" },
      "textures": { "default": "textures/entity/molten_god" },
      "geometry": { "default": "geometry.ob_god" },
      "animations": {
        "idle": "animation.ob_god.idle",
        "walk": "animation.ob_god.walk"
      },
      "scripts": {
        "animate": [
          { "walk": "query.modified_move_speed > 0.05" },
          { "idle": "query.modified_move_speed <= 0.05" }
        ]
      },
      "render_controllers": ["controller.render.default"],
      "spawn_egg": { "base_color": "#fff3a0", "overlay_color": "#ffffff" }
    }
  }
}
