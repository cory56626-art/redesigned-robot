{
	"format_version": "1.21.0",
	"minecraft:client_entity": {
		"description": {
			"identifier": "pntmc:king_trigger",
			"materials": {
				"default": "entity_emissive_alpha"
			},
			"textures": {
				"default": "textures/pntmcking/entity/pntmc_king_texture"
			},
			"geometry": {
				"default": "geometry.pntmc_king"
			},
			"render_controllers": ["controller.render.default"],
			"spawn_egg": {
				"base_color": "#ffffff",
				"overlay_color": "#000000"
			},
			"animations": {
				"calm_idle": "animation.pntmc_king.calm_idle",
				"calm_move": "animation.pntmc_king.calm_move",
				"run_idle": "animation.pntmc_king.run_idle",
				"run": "animation.pntmc_king.run",
				"crawl": "animation.pntmc_king.crawl",
				"crouch_idle": "animation.pntmc_king.crouch_idle",
				"crouch_run": "animation.pntmc_king.crouch_run",
				"spotted": "animation.pntmc_king.spotted",
				"flee": "animation.pntmc_king.flee",
				"PNTMCisKING": "controller.animation.pntmc_king"
			},
			"scripts": {
				"scale": "2.5",
				"animate": [
					{
						"calm_idle": "query.modified_move_speed < 0.05 && query.mark_variant == 1 && !query.is_sheared && !query.is_ignited && !query.is_saddled"
					},
					{
						"calm_move": "query.modified_move_speed < 0.8 && query.modified_move_speed > 0.05 && !query.is_sheared && !query.is_ignited"
					},
					{
						"run_idle": "query.modified_move_speed < 0.05 && query.mark_variant == 2 && !query.is_sheared && !query.is_ignited && !query.is_saddled"
					},
					{
						"run": "query.modified_move_speed > 0.8 && !query.is_sheared && !query.is_ignited"
					},
					{
						"crawl": "query.is_ignited && query.is_sheared && !query.is_saddled || query.is_ignited && !query.is_sheared && !query.is_saddled"
					},
					{
						"crouch_idle": "query.modified_move_speed < 0.05 && query.is_sheared && !query.is_ignited && !query.is_saddled"
					},
					{
						"crouch_run": "query.modified_move_speed > 0.05 && query.is_sheared && !query.is_ignited && !query.is_saddled"
					},
					{
						"spotted": "query.modified_move_speed < 0.05 && query.is_saddled"
					}
				]
			}
		}
	}
}