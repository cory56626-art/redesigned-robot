{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "mss:minion_enderman",
      "materials": {
        "default": "enderman"
      },
      "textures": {
        "default": "textures/entity/enderman/enderman"
      },
      "geometry": {
        "default": "geometry.enderman.v1.8"
      },
      "animations": {
        "base_pose": "animation.enderman.base_pose",
        "arms_legs": "animation.enderman.arms_legs",
        "look_at_target": "animation.humanoid.look_at_target.default"
      },
      "scripts": {
        "animate": [
          "base_pose",
          "look_at_target",
          "arms_legs"
        ],
        "pre_animation": [
          "variable.tcos0 = (Math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed) * 28.65;"
        ]
      },
      "render_controllers": [
        "controller.render.mss_default"
      ]
    }
  }
}