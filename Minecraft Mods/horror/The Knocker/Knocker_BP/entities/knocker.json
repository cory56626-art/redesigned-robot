            {
              "filters": { "test": "is_family", "subject": "other", "value": "player" },
              "max_dist": 48
            }
          ]
        },
        "minecraft:behavior.melee_attack": {
          "priority": 3,
          "track_target": true,
          "reach_multiplier": 1.4,
          "speed_multiplier": 1.1
        }
      },
      "knocker:stage_enraged": {
        "minecraft:movement": { "value": 0.47 },
        "minecraft:navigation.walk": {
          "can_path_over_water": true,
          "can_pass_doors": true,
          "can_open_doors": true,
          "can_break_doors": true,
          "avoid_damage_blocks": false,
          "avoid_water": false
        },
        "minecraft:attack": { "damage": 9 },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 2,
          "must_see": false,
          "must_reach": false,
          "reselect_targets": true,
          "within_radius": 64,
          "entity_types": [
            {
              "filters": { "test": "is_family", "subject": "other", "value": "player" },
              "max_dist": 64
            }
          ]
        },
        "minecraft:behavior.melee_attack": {
          "priority": 3,
          "track_target": true,
          "reach_multiplier": 1.5,
          "speed_multiplier": 1.25
        }
      },

      "knocker:pose_crawl": {
        "minecraft:mark_variant": { "value": 2 }
      },
      "knocker:pose_scream": {
        "minecraft:mark_variant": { "value": 3 }
      },
      "knocker:pose_knock": {
        "minecraft:mark_variant": { "value": 4 }
      },
      "knocker:body_crawl": {
        "minecraft:collision_box": { "width": 0.6, "height": 0.95 }
      }
    },

    "components": {
      "minecraft:type_family": { "family": ["knocker", "monster", "mob", "undead"] },
      "minecraft:health": { "value": 120, "max": 120 },
      "minecraft:physics": {},
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:movement": { "value": 0.23 },
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "can_pass_doors": true,
        "can_open_doors": true,
        "can_break_doors": false,
        "avoid_damage_blocks": false,
        "avoid_water": false
      },
      "minecraft:collision_box": { "width": 0.6, "height": 2.1 },
      "minecraft:knockback_resistance": { "value": 0.75 },
      "minecraft:pushable": { "is_pushable": false, "is_pushable_by_piston": true },
      "minecraft:follow_range": { "value": 64, "max": 64 },
      "minecraft:attack": { "damage": 6 },
      "minecraft:mark_variant": { "value": 0 },
      "minecraft:fire_immune": {},
      "minecraft:breathable": {
        "breathes_air": true,
        "breathes_water": true,
        "breathes_lava": true,
        "generates_bubbles": false
      },
      "minecraft:damage_sensor": {
        "triggers": [
          { "cause": "fire", "deals_damage": false },
          { "cause": "fire_tick", "deals_damage": false },
          { "cause": "lava", "deals_damage": false },
          { "cause": "fall", "deals_damage": false },
          { "cause": "drowning", "deals_damage": false }
        ]
      },
      "minecraft:nameable": { "always_show": false, "allow_name_tag_renaming": true },
      "minecraft:equippable": {
        "slots": [
          {
            "slot_index": 0,
            "accepted_items": ["minecraft:iron_axe", "minecraft:iron_pickaxe"]
          }
        ]
      },
      "minecraft:equipment": { "table": "loot_tables/equipment/knocker.json" },
      "minecraft:loot": { "table": "loot_tables/entities/knocker.json" },
      "minecraft:behavior.float": { "priority": 0 },
      "minecraft:behavior.hurt_by_target": { "priority": 1 },
      "minecraft:behavior.random_stroll": {
        "priority": 7,
        "speed_multiplier": 0.55,
        "xz_dist": 14,
        "y_dist": 5
      },
      "minecraft:behavior.look_at_player": {
        "priority": 8,
        "look_distance": 18,
        "probability": 1.0,
        "angle_of_view_horizontal": 360
      },
      "minecraft:behavior.random_look_around": { "priority": 9 }
    },

    "events": {
      "knocker:set_calm": {
        "remove": { "component_groups": ["knocker:stage_curious", "knocker:stage_hostile", "knocker:stage_enraged"] }
      },
      "knocker:set_curious": {
        "add": { "component_groups": ["knocker:stage_curious"] },
        "remove": { "component_groups": ["knocker:stage_hostile", "knocker:stage_enraged"] }
      },
      "knocker:set_hostile": {
        "add": { "component_groups": ["knocker:stage_hostile"] },
        "remove": { "component_groups": ["knocker:stage_curious", "knocker:stage_enraged"] }
      },
      "knocker:set_enraged": {
        "add": { "component_groups": ["knocker:stage_enraged"] },
        "remove": { "component_groups": ["knocker:stage_curious", "knocker:stage_hostile"] }
      },

      "knocker:pose_reset": {
        "remove": { "component_groups": ["knocker:pose_crawl", "knocker:pose_scream", "knocker:pose_knock"] }
      },
      "knocker:pose_scream_on": {
        "add": { "component_groups": ["knocker:pose_scream"] },
        "remove": { "component_groups": ["knocker:pose_crawl", "knocker:pose_knock"] }
      },
      "knocker:pose_knock_on": {
        "add": { "component_groups": ["knocker:pose_knock"] },
        "remove": { "component_groups": ["knocker:pose_crawl", "knocker:pose_scream"] }
      },
      "knocker:start_crawl": {
        "add": { "component_groups": ["knocker:body_crawl", "knocker:pose_crawl"] },
        "remove": { "component_groups": ["knocker:pose_scream", "knocker:pose_knock"] }
      },
      "knocker:stop_crawl": {
        "remove": { "component_groups": ["knocker:body_crawl", "knocker:pose_crawl"] }
      }
    }
  }
}
