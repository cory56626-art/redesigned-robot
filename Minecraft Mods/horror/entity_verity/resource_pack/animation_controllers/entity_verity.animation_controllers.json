{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.entity_verity.general": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": ["idle_twitch"],
          "transitions": [
            { "alert": "q.property('verity:anim') == 1" },
            { "chase": "q.property('verity:anim') == 2" },
            { "climb": "q.property('verity:anim') == 3" },
            { "crawl": "q.property('verity:anim') == 4" },
            { "phase": "q.property('verity:anim') == 5" }
          ]
        },
        "alert": {
          "animations": ["detect_shake"],
          "blend_transition": 0.04,
          "transitions": [
            { "chase": "q.property('verity:anim') == 2" },
            { "idle": "q.property('verity:anim') == 0" }
          ]
        },
        "chase": {
          "animations": ["jitter_sprint"],
          "blend_transition": 0.0,
          "transitions": [
            { "idle": "q.property('verity:anim') == 0" },
            { "alert": "q.property('verity:anim') == 1" },
            { "climb": "q.property('verity:anim') == 3" },
            { "crawl": "q.property('verity:anim') == 4" },
            { "phase": "q.property('verity:anim') == 5" }
          ]
        },
        "climb": {
          "animations": ["climb"],
          "blend_transition": 0.1,
          "transitions": [
            { "chase": "q.property('verity:anim') == 2" },
            { "crawl": "q.property('verity:anim') == 4" },
            { "phase": "q.property('verity:anim') == 5" },
            { "idle": "q.property('verity:anim') == 0" }
          ]
        },
        "crawl": {
          "animations": ["crawl"],
          "blend_transition": 0.1,
          "transitions": [
            { "chase": "q.property('verity:anim') == 2" },
            { "phase": "q.property('verity:anim') == 5" },
            { "idle": "q.property('verity:anim') == 0" }
          ]
        },
        "phase": {
          "animations": ["face_break"],
          "blend_transition": 0.1,
          "transitions": [
            { "crawl": "q.property('verity:anim') == 4" },
            { "chase": "q.property('verity:anim') == 2" },
            { "idle": "q.property('verity:anim') == 0" }
          ]
        }
      }
    }
  }
}
