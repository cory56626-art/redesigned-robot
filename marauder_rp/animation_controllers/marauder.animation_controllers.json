{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.marauder.move": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": [ "idle" ],
          "blend_transition": 0.2,
          "transitions": [
            { "walk": "query.modified_move_speed > 0.1" }
          ]
        },
        "walk": {
          "animations": [ "walk" ],
          "blend_transition": 0.2,
          "transitions": [
            { "idle": "query.modified_move_speed <= 0.1" }
          ]
        }
      }
    },
    "controller.animation.marauder.action": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "transitions": [
            { "kneeling": "query.property('marauder:kneeling')" },
            { "omni": "query.property('marauder:omni')" },
            { "slash": "query.property('marauder:slash')" },
            { "aim": "query.property('marauder:aim')" },
            { "guard": "query.property('marauder:guard')" },
            { "cast": "query.property('marauder:casting')" },
            { "swing": "query.property('marauder:attacking')" }
          ]
        },
        "swing": {
          "animations": [ "attack" ],
          "blend_transition": 0.1,
          "transitions": [
            { "kneeling": "query.property('marauder:kneeling')" },
            { "omni": "query.property('marauder:omni')" },
            { "slash": "query.property('marauder:slash')" },
            { "aim": "query.property('marauder:aim')" },
            { "guard": "query.property('marauder:guard')" },
            { "cast": "query.property('marauder:casting')" },
            { "idle": "!query.property('marauder:attacking')" }
          ]
        },
        "slash": {
          "animations": [ "slash" ],
          "blend_transition": 0.1,
          "transitions": [
            { "kneeling": "query.property('marauder:kneeling')" },
            { "omni": "query.property('marauder:omni')" },
            { "idle": "!query.property('marauder:slash')" }
          ]
        },
        "aim": {
          "animations": [ "aim" ],
          "blend_transition": 0.15,
          "transitions": [
            { "kneeling": "query.property('marauder:kneeling')" },
            { "omni": "query.property('marauder:omni')" },
            { "idle": "!query.property('marauder:aim')" }
          ]
        },
        "guard": {
          "animations": [ "guard" ],
          "blend_transition": 0.12,
          "transitions": [
            { "kneeling": "query.property('marauder:kneeling')" },
            { "omni": "query.property('marauder:omni')" },
            { "idle": "!query.property('marauder:guard')" }
          ]
        },
        "cast": {
          "animations": [ "cast" ],
          "blend_transition": 0.15,
          "transitions": [
            { "kneeling": "query.property('marauder:kneeling')" },
            { "omni": "query.property('marauder:omni')" },
            { "slash": "query.property('marauder:slash')" },
            { "aim": "query.property('marauder:aim')" },
            { "guard": "query.property('marauder:guard')" },
            { "idle": "!query.property('marauder:casting')" }
          ]
        },
        "omni": {
          "animations": [ "omni_punch" ],
          "blend_transition": 0.15,
          "transitions": [
            { "kneeling": "query.property('marauder:kneeling')" },
            { "idle": "!query.property('marauder:omni')" }
          ]
        },
        "kneeling": {
          "animations": [ "take_knee" ],
          "blend_transition": 0.3,
          "transitions": [
            { "idle": "!query.property('marauder:kneeling')" }
          ]
        }
      }
    },
    "controller.animation.marauder.afterimage_action": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "transitions": [
            { "swing": "query.property('marauder:attacking')" }
          ]
        },
        "swing": {
          "animations": [ "attack" ],
          "blend_transition": 0.15,
          "transitions": [
            { "idle": "!query.property('marauder:attacking')" }
          ]
        }
      }
    }
  }
}
