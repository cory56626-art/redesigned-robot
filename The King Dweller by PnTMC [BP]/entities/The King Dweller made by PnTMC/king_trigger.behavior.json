{
	"format_version": "1.16.0",
	"minecraft:entity": {
	  "description": {
		"identifier": "pntmc:king_trigger",
		"is_spawnable": true,
		"is_summonable": true,
		"is_experimental": false,
		"animations": {
			"king_pntmc_calm_idle": "controller.animation.king_calm_idle_PNTMC",
			"king_pntmc_run_idle": "controller.animation.king_run_idle_PNTMC",
			"king_disappear_timer": "controller.animation.king_disappear_timer_PNTMC"
		},
		"scripts": {
			"animate": [
				"king_pntmc_calm_idle",
				"king_pntmc_run_idle",
				"king_disappear_timer"
			]
		}
	  },
	  "component_groups": {
		"pntmc:despawn": {
			"minecraft:instant_despawn": {}
		},
		"pntmc:crawl": {
			"minecraft:is_ignited": {},
			"minecraft:timer": {
				"time": 1,
				"looping": false,
				"time_down_event": {
					"event": "pntmc:crawled",
					"target": "self"
				}
			}
		},
		"pntmc:crouch": {
			"minecraft:is_sheared": {},
			"minecraft:timer": {
				"time": 1,
				"looping": false,
				"time_down_event": {
					"event": "pntmc:crouched",
					"target": "self"
				}
			}
		},
		"pntmc:calm_idle": {
			"minecraft:mark_variant": {
				"value": 1
			}
		},
		"pntmc:run_idle": {
			"minecraft:mark_variant": {
				"value": 2
			}
		},
		"pntmc:king_transformation": {
			"minecraft:transformation": {
				"into": "pntmc:king"
			}
		}
	  },
	  "components": {
		"minecraft:type_family": {
		  "family": [ "pntmc", "mob", "king" ]
		},
		"minecraft:nameable": {
		},
		"minecraft:collision_box": {
			"height": 0.9,
			"width": 0.5
		},
		"minecraft:mark_variant": {
			"value": 0
		},
		"minecraft:variant": {
			"value": 0
		},
		"minecraft:despawn": {
			"despawn_from_distance": {}
		},
		"minecraft:break_blocks": {
			"breakable_blocks": [
				"glass",
				"glass_pane",
				"trapdoor"
			]
		},
		"minecraft:annotation.break_door": {
			"break_time": 1.5,
			"min_difficulty": "easy"
		  },
		"minecraft:navigation.climb": {
			"can_swim": true,
			"avoid_damage_blocks": false,
			"can_walk_in_lava": true
		},
		"minecraft:behavior.float": {
			"priority": 10
		},
		"minecraft:custom_hit_test":{
			"hitboxes": [
			  {
				"height": 4.0,
				"width": 2.0,
				"pivot": [ 0, 2, 0 ]
			  }
			]
		},
		"minecraft:looked_at": {
          "search_radius": 60,
          "look_at_locations": [
            {
              "location": "head"
            },
            {
              "location": "body"
            },
            {
              "location": "feet",
              "vertical_offset": 0.5
            }
          ],
          "set_target": "never",
          "find_players_only": true,
          "looked_at_cooldown": 0.1,
          "field_of_view": 8,
          "scale_fov_by_distance": false,
          "line_of_sight_obstruction_type": "collision_for_camera",
          "looked_at_event": {
            "event": "pntmc:king_transformation",
            "target": "self"
          }
        },
		"minecraft:environment_sensor": {
			"triggers": [
				{
					"event": "pntmc:king_transformation",
					"target": "self",
					"filters": {
						"test": "distance_to_nearest_player",
						"value": 3,
						"operator": "<="
					}
				}
			]
		},
		"minecraft:damage_sensor": {
			"triggers": [
				{
					"cause": "all",
					"deals_damage": "yes",
					"on_damage": {
						"filters": {
							"test": "has_damage",
							"subject": "self",
							"value": "fatal"
						},
						"event": "pntmc:king_death"
					}
				}
			]
		},
		"minecraft:health": {
		  "value": 200,
		  "max": 200
		},
		"minecraft:hurt_on_condition": {
		  "damage_conditions": [
			{
			  "filters": { "test": "in_lava", "subject": "self", "operator": "==", "value": true },
			  "cause": "lava",
			  "damage_per_tick": 4
			}
		  ]
		},
        "minecraft:movement": {
			"value": 0.56
		},
		"minecraft:underwater_movement": {
			"value": 0.46
		},
		"minecraft:movement.basic": {
		},
		"minecraft:jump.static": {
		},
		"minecraft:can_climb": {
		},
		"minecraft:attack": {
		  "damage": 6
		},
		"minecraft:knockback_resistance": {
		  "value": 1
		},
		"minecraft:behavior.random_stroll": {
		  "priority": 6,
		  "speed_multiplier": 0.6,
		  "xz_dist": 16
		},
		"minecraft:behavior.random_look_around": {
		  "priority": 8
		},
		"minecraft:persistent": {
		},
		"minecraft:physics": {
		},
		"minecraft:pushable": {
		  "is_pushable": true,
		  "is_pushable_by_piston": true
		},
		"minecraft:conditional_bandwidth_optimization": {
		}
	  },
  
	  "events": {
		"minecraft:entity_spawned": {
			"add": {
				"component_groups": [
					"pntmc:calm_idle"
				]
			}
		},
		"pntmc:despawn": {
			"add": {
				"component_groups": [
					"pntmc:despawn"
				]
			}
		},
		"pntmc:crawl": {
			"add": {
				"component_groups": [
					"pntmc:crawl"
				]
			},
			"remove": {
				"component_groups": [
					"pntmc:crouch"
				]
			}
		},
		"pntmc:crouch": {
			"add": {
				"component_groups": [
					"pntmc:crouch"
				]
			}
		},
		"pntmc:crawled": {
			"remove": {
				"component_groups": [
					"pntmc:crawl",
					"pntmc:crouch"
				]
			}
		},
		"pntmc:crouched": {
			"remove": {
				"component_groups": [
					"pntmc:crouch",
					"pntmc:crawl"
				]
			}
		},
		"pntmc:calm_idle": {
			"add": {
				"component_groups": [
					"pntmc:calm_idle"
				]
			}
		},
		"pntmc:run_idle": {
			"add": {
				"component_groups": [
					"pntmc:run_idle"
				]
			}
		},
		"pntmc:king_transformation": {
			"add": {
				"component_groups": [
					"pntmc:king_transformation"
				]
			}
		}
	  }
	}
  }
  