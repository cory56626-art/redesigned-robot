{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.smiling_man.move": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": ["idle"],
          "transitions": [{ "walk": "query.modified_move_speed > 0.05" }]
        },
        "walk": {
          "animations": ["walk"],
          "transitions": [{ "idle": "query.modified_move_speed <= 0.05" }]
        }
      }
    }
  }
}
