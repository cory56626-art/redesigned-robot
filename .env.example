# Aurel reads provider keys from the environment. Copy to .env or export them.
# Any subset works — providers with a missing key are hidden from the model switcher.

GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
OPEN_ROUTER_API_KEY=
COHERE_API_KEY=
GEMINI_API_KEY=
GLM5.2_API_KEY=
NLP_CLOUD_API_KEY=

# Optional: outbound proxy + extra CA (auto-detected in managed environments)
# HTTPS_PROXY=http://127.0.0.1:8080
# NODE_EXTRA_CA_CERTS=/path/to/ca-bundle.crt

# Server
PORT=4173
# Comma-separated bcrypt-free auth is used; set a salt to invalidate old sessions.
AUREL_AUTH_SALT=change-me
