# ─────────────────────────────────────────────────────────────
#  AI Money App — environment configuration
#  Copy this file to ".env" and fill in your own keys.
#  NEVER commit your real .env file. (.gitignore already blocks it.)
# ─────────────────────────────────────────────────────────────

# --- AI model ---
# The app prefers Mistral. If MISTRAL_API_KEY is missing/invalid it
# automatically falls back to OpenRouter.
# Get one at https://console.mistral.ai/
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# Fallback provider. Get a key at https://openrouter.ai/keys
OPEN_ROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-large

# --- Stripe (the part that ACTUALLY collects money) ---
# Use a TEST key (sk_test_...) while experimenting, LIVE key (sk_live_...)
# only when you're ready to take real money.
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# --- Cash App ---
# Cash App has no public API to programmatically pull money in.
# Put your $cashtag here and the app will show a "pay me" link/QR.
CASHAPP_CASHTAG=

# --- Server ---
PORT=3000
