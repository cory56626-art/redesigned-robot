{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.playerbot.move": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": ["idle"],
          "blend_transition": 0.2,
          "transitions": [
            { "work": "query.property('playerbot:is_mining') || query.property('playerbot:is_attacking')" },
            { "walk": "query.property('playerbot:is_moving')" }
          ]
        },
        "walk": {
          "animations": ["walk"],
          "blend_transition": 0.2,
          "transitions": [
            { "work": "query.property('playerbot:is_mining') || query.property('playerbot:is_attacking')" },
            { "idle": "!query.property('playerbot:is_moving')" }
          ]
        },
        "work": {
          "animations": ["swing"],
          "blend_transition": 0.1,
          "transitions": [
            { "walk": "query.property('playerbot:is_moving') && !(query.property('playerbot:is_mining') || query.property('playerbot:is_attacking'))" },
            { "idle": "!(query.property('playerbot:is_mining') || query.property('playerbot:is_attacking'))" }
          ]
        }
      }
    }
  }
}
