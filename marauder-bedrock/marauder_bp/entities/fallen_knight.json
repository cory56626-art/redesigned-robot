{
  "format_version": "1.20.60",
  "minecraft:entity": {
    "description": {
      "identifier": "marauder:fallen_knight",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {
        "marauder:attacking": { "type": "bool", "default": false, "client_sync": true },
        "marauder:slash": { "type": "bool", "default": false, "client_sync": true }
      }
    },
    "component_groups": {
      "marauder:rising": {
        "minecraft:damage_sensor": { "triggers": [ { "deals_damage": false } ] },
