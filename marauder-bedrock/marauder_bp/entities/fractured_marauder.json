      },
      "minecraft:behavior.melee_attack": {
        "priority": 3,
        "speed_multiplier": 1.2,
        "track_target": true,
        "require_complete_path": false,
        "reach_multiplier": 1.6,
        "melee_fov": 180
      },
      "minecraft:behavior.random_stroll": {
        "priority": 6,
        "speed_multiplier": 0.6,
        "interval": 120
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7,
        "look_distance": 24
      },
      "minecraft:behavior.random_look_around": { "priority": 8 }
    },
    "events": {
      "marauder:become_boss": {
        "add": { "component_groups": ["marauder:boss"] }
      },
      "marauder:clear_boss": {
        "remove": { "component_groups": ["marauder:boss"] }
      },
      "marauder:seraph_on": {
        "add": { "component_groups": ["marauder:seraph"] }
      },
      "marauder:seraph_off": {
        "remove": { "component_groups": ["marauder:seraph"] }
      },
      "marauder:stun_on": {
        "add": { "component_groups": ["marauder:stunned"] }
      },
      "marauder:stun_off": {
        "remove": { "component_groups": ["marauder:stunned"] }
      },
      "marauder:invulnerable_on": {
        "add": { "component_groups": ["marauder:invulnerable"] }
      },
      "marauder:invulnerable_off": {
        "remove": { "component_groups": ["marauder:invulnerable"] }
      },
      "marauder:ffa_on": {
        "add": { "component_groups": ["marauder:free_for_all"] }
      },
      "marauder:ffa_off": {
        "remove": { "component_groups": ["marauder:free_for_all"] }
      }
    }
