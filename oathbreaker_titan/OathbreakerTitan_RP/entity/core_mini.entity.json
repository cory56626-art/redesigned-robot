{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "ob:core_mini",
      "materials": { "default": "entity_alphatest" },
      "textures": {
        "default": "textures/entity/oathbreaker_titan_rage"
      },
      "geometry": { "default": "geometry.ob_titan" },
      "animations": {
        "idle": "animation.ob_titan.idle",
        "walk": "animation.ob_titan.walk",
        "death": "animation.ob_titan.death"
      },
      "scripts": {
        "animate": [
          { "idle": "q.modified_move_speed <= 0.02 && q.is_alive" },
          { "walk": "q.modified_move_speed > 0.02 && q.is_alive" },
          { "death": "!q.is_alive" }
        ]
      },
      "render_controllers": ["controller.render.default"],
      "spawn_egg": {
        "base_color": "#4a2a22",
        "overlay_color": "#ffb040"
      }
    }
  }
}
