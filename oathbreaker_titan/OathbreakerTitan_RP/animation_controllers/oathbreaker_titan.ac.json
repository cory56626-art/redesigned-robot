{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.ob_titan.attack": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            { "cleave": "q.property('ob:attack_state') == 'cleave'" },
            { "leap": "q.property('ob:attack_state') == 'leap'" },
            { "slam": "q.property('ob:attack_state') == 'slam'" },
            { "dash": "q.property('ob:attack_state') == 'dash'" },
            { "parry": "q.property('ob:attack_state') == 'parry'" },
            { "judgment": "q.property('ob:attack_state') == 'judgment'" },
            { "stunned": "q.property('ob:attack_state') == 'stunned'" },
            { "throw": "q.property('ob:attack_state') == 'throw'" },
            { "summon": "q.property('ob:attack_state') == 'summon'" },
            { "smash": "q.property('ob:attack_state') == 'smash'" },
            { "grapple": "q.property('ob:attack_state') == 'grapple'" },
            { "stumble": "q.property('ob:attack_state') == 'stumble'" },
            { "drag": "q.property('ob:attack_state') == 'drag'" },
            { "pummel": "q.property('ob:attack_state') == 'pummel'" },
            { "molten": "q.property('ob:attack_state') == 'molten'" },
            { "rush": "q.property('ob:attack_state') == 'rush'" },
            { "skyhurl": "q.property('ob:attack_state') == 'skyhurl'" }
          ]
        },
        "cleave": {
          "animations": ["cleave_anim"],
          "blend_transition": 0.1,
          "transitions": [{ "default": "q.property('ob:attack_state') != 'cleave'" }]
        },
        "leap": {
          "animations": ["leap_anim"],
          "blend_transition": 0.1,
          "transitions": [
            { "slam": "q.property('ob:attack_state') == 'slam'" },
            { "default": "q.property('ob:attack_state') != 'leap' && q.property('ob:attack_state') != 'slam'" }
          ]
        },
        "slam": {
          "animations": ["slam_anim"],
          "blend_transition": 0.05,
          "transitions": [
            { "drag": "q.property('ob:attack_state') == 'drag'" },
            { "default": "q.property('ob:attack_state') != 'slam' && q.property('ob:attack_state') != 'drag'" }
          ]
        },
        "drag": {
          "animations": ["drag_anim"],
          "blend_transition": 0.1,
          "transitions": [
            { "pummel": "q.property('ob:attack_state') == 'pummel'" },
            { "default": "q.property('ob:attack_state') != 'drag' && q.property('ob:attack_state') != 'pummel'" }
          ]
        },
        "pummel": {
          "animations": ["pummel_anim"],
          "blend_transition": 0.1,
          "transitions": [{ "default": "q.property('ob:attack_state') != 'pummel'" }]
        },
        "molten": {
          "animations": ["molten_anim"],
          "blend_transition": 0.1,
          "transitions": [{ "default": "q.property('ob:attack_state') != 'molten'" }]
        },
        "rush": {
          "animations": ["dash_anim"],
          "blend_transition": 0.08,
          "transitions": [
            { "skyhurl": "q.property('ob:attack_state') == 'skyhurl'" },
            { "default": "q.property('ob:attack_state') != 'rush' && q.property('ob:attack_state') != 'skyhurl'" }
          ]
        },
        "skyhurl": {
          "animations": ["leap_anim"],
          "blend_transition": 0.1,
          "transitions": [{ "default": "q.property('ob:attack_state') != 'skyhurl'" }]
        },
        "dash": {
          "animations": ["dash_anim"],
          "blend_transition": 0.1,
          "transitions": [{ "default": "q.property('ob:attack_state') != 'dash'" }]
        },
        "parry": {
          "animations": ["parry_anim"],
          "blend_transition": 0.05,
          "transitions": [{ "default": "q.property('ob:attack_state') != 'parry'" }]
        },
        "judgment": {
          "animations": ["judgment_anim"],
          "blend_transition": 0.2,
          "transitions": [{ "default": "q.property('ob:attack_state') != 'judgment'" }]
        },
        "stunned": {
          "animations": ["stunned_anim"],
          "blend_transition": 0.2,
          "transitions": [{ "default": "q.property('ob:attack_state') != 'stunned'" }]
        },
        "throw": {
          "animations": ["throw_anim"],
          "blend_transition": 0.1,
          "transitions": [{ "default": "q.property('ob:attack_state') != 'throw'" }]
        },
        "summon": {
          "animations": ["summon_anim"],
          "blend_transition": 0.15,
          "transitions": [{ "default": "q.property('ob:attack_state') != 'summon'" }]
        },
        "smash": {
          "animations": ["smash_anim"],
          "blend_transition": 0.1,
          "transitions": [{ "default": "q.property('ob:attack_state') != 'smash'" }]
        },
        "grapple": {
          "animations": ["grapple_anim"],
          "blend_transition": 0.08,
          "transitions": [
            { "stumble": "q.property('ob:attack_state') == 'stumble'" },
            { "default": "q.property('ob:attack_state') != 'grapple' && q.property('ob:attack_state') != 'stumble'" }
          ]
        },
        "stumble": {
          "animations": ["stumble_anim"],
          "blend_transition": 0.15,
          "transitions": [{ "default": "q.property('ob:attack_state') != 'stumble'" }]
        }
      }
    }
  }
}
