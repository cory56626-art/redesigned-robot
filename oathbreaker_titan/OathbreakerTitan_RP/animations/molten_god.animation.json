      "bones": {
        "right_arm": { "rotation": { "0.0": [0, 0, -6], "0.5": [-178, 0, -14], "1.4": [-176, 0, -14] } },
        "left_arm": { "rotation": { "0.0": [0, 0, 6], "0.5": [-178, 0, 14], "1.4": [-176, 0, 14] } },
        "head": { "rotation": { "0.0": [0, 0, 0], "0.5": [-40, 0, 0], "1.4": [-38, 0, 0] } },
        "body": { "rotation": { "0.0": [0, 0, 0], "0.5": [-10, 0, 0], "1.4": [-8, 0, 0] } }
      }
    },
    "animation.ob_god.blades": {
      "loop": "hold_on_last_frame",
      "animation_length": 1.2,
      "bones": {
        "right_arm": { "rotation": { "0.0": [0, 0, -6], "0.5": [-60, 0, -95], "1.2": [-50, 0, -85] } },
        "left_arm": { "rotation": { "0.0": [0, 0, 6], "0.5": [-60, 0, 95], "1.2": [-50, 0, 85] } },
        "body": { "rotation": { "0.0": [0, 0, 0], "0.6": [-6, 0, 0], "1.2": [0, 0, 0] } },
        "head": { "rotation": { "0.0": [0, 0, 0], "0.5": [-20, 0, 0], "1.2": [-15, 0, 0] } }
      }
    },
    "animation.ob_god.chain": {
      "loop": "hold_on_last_frame",
      "animation_length": 0.4,
      "bones": {
        "right_arm": { "rotation": { "0.0": [-40, 0, -60], "0.13": [-75, -30, -30], "0.4": [-40, 0, -85] } },
        "left_arm": { "rotation": { "0.0": [-40, 0, 60], "0.18": [-40, 0, 60], "0.28": [-75, 30, 30], "0.4": [-40, 0, 85] } },
        "body": { "rotation": { "0.0": [0, 20, 0], "0.13": [8, -22, 0], "0.4": [0, 18, 0] } }
      }
    }
  }
}
