{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.marauder.move": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            "idle",
            { "walk": "query.modified_move_speed > 0.1" }
          ]
        }
      }
    },
    "controller.animation.marauder.action": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "transitions": [ { "swing": "query.property('marauder:attacking')" } ]
        },
        "swing": {
          "animations": [ "attack" ],
          "transitions": [ { "idle": "!query.property('marauder:attacking')" } ]
        }
      }
    }
  }
}
